+import warnings
+
+DEFAULT_HOST = "127.0.0.1"
+DEFAULT_PORT = 8080
+DEFAULT_TIMEOUT_S = 30
+
+_KEY_MSG = "config key 'timeout' is deprecated; use 'timeout_s' instead"
+_ATTR_MSG = "Config.timeout is deprecated; use Config.timeout_s instead"
+
+_UNSET = object()
+
+
+def _check_timeout_s(value):
+    """Return `value` if it is a positive int/float, else raise ValueError."""
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        raise ValueError(f"timeout_s must be a positive number, got {value!r}")
+    if not value > 0:
+        raise ValueError(f"timeout_s must be a positive number, got {value!r}")
+    return value
+
+
 class Config:
-    def __init__(self, host, port, timeout):
+    def __init__(self, host=DEFAULT_HOST, port=DEFAULT_PORT, timeout_s=_UNSET, *, timeout=_UNSET):
+        # `timeout` (deprecated) is keyword-only; the positional third argument
+        # keeps working for old callers, where it meant the timeout in seconds.
+        if timeout is not _UNSET:
+            if timeout_s is not _UNSET:
+                raise ValueError(
+                    "got both 'timeout' and 'timeout_s'; "
+                    "'timeout' is deprecated, specify only 'timeout_s'"
+                )
+            warnings.warn(_ATTR_MSG, DeprecationWarning, stacklevel=2)
+            timeout_s = timeout
+        if timeout_s is _UNSET:
+            timeout_s = DEFAULT_TIMEOUT_S
+
         self.host = host
         self.port = port
-        self.timeout = timeout
