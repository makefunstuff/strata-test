@@ -0,0 +1,93 @@
+import unittest
+import warnings
+
+from svc.client import Client
+from svc.config import Config, load_config
+from svc.server import Server
+
+
+class TimeoutSConfigTest(unittest.TestCase):
+    # --- new key -----------------------------------------------------------
+    def test_new_key_accepted(self):
+        c = load_config({"timeout_s": 5})
+        self.assertEqual(c.timeout_s, 5)
+
+    def test_default_is_30(self):
+        c = load_config({})
+        self.assertEqual(c.timeout_s, 30)
+
+    def test_float_allowed(self):
+        self.assertEqual(load_config({"timeout_s": 0.5}).timeout_s, 0.5)
+
+    # --- old key -----------------------------------------------------------
+    def test_old_key_warns_and_is_used(self):
+        with warnings.catch_warnings(record=True) as caught:
+            warnings.simplefilter("always")
+            c = load_config({"timeout": 7})
+        self.assertEqual(c.timeout_s, 7)
+        self.assertEqual(len(caught), 1)
+        self.assertIs(caught[0].category, DeprecationWarning)
+        self.assertIn("timeout_s", str(caught[0].message))
+
+    def test_both_keys_raise(self):
+        with self.assertRaises(ValueError):
+            load_config({"timeout": 7, "timeout_s": 7})
+
+    # --- deprecated attribute ---------------------------------------------
+    def test_timeout_attribute_is_deprecated_alias(self):
+        c = load_config({"timeout_s": 9})
+        with warnings.catch_warnings(record=True) as caught:
+            warnings.simplefilter("always")
+            value = c.timeout
+        self.assertEqual(value, 9)
+        self.assertEqual(len(caught), 1)
+        self.assertIs(caught[0].category, DeprecationWarning)
+
+    def test_timeout_attribute_is_read_only(self):
+        c = load_config({"timeout_s": 9})
+        with self.assertRaises(AttributeError):
+            c.timeout = 3
+
+    # --- validation -------------------------------------------------------
+    def test_non_positive_raises(self):
+        for bad in (0, -1, -0.5):
+            with self.subTest(bad=bad):
+                with self.assertRaises(ValueError):
+                    load_config({"timeout_s": bad})
+
+    def test_non_numeric_raises(self):
+        for bad in ("30", None, [], {}):
+            with self.subTest(bad=bad):
+                with self.assertRaises(ValueError):
+                    load_config({"timeout_s": bad})
+
+    def test_deprecated_key_value_is_validated(self):
+        with warnings.catch_warnings():
+            warnings.simplefilter("ignore", DeprecationWarning)
+            with self.assertRaises(ValueError):
+                load_config({"timeout": 0})
+
+    def test_direct_construction_still_works(self):
+        c = Config("h", 1234, 11)
+        self.assertEqual((c.host, c.port, c.timeout_s), ("h", 1234, 11))
+
+    # --- consumers --------------------------------------------------------
+    def test_client_uses_timeout_s_without_warning(self):
+        c = load_config({"timeout_s": 4})
+        with warnings.catch_warnings(record=True) as caught:
+            warnings.simplefilter("always")
+            opts = Client(c).request_options()
+        self.assertEqual(opts["timeout"], 4)
+        self.assertEqual([str(w.message) for w in caught], [])
+
+    def test_server_uses_timeout_s_without_warning(self):
+        c = load_config({"timeout_s": 4})
+        with warnings.catch_warnings(record=True) as caught:
+            warnings.simplefilter("always")
+            deadline = Server(c).keepalive_deadline(100)
+        self.assertEqual(deadline, 108)
+        self.assertEqual([str(w.message) for w in caught], [])
+
+
+if __name__ == "__main__":
+    unittest.main()
