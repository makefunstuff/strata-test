 import argparse
 import csv
+import json
 import sys
 
+FORMATS = ("table", "json")
+
 
 def load(path):
     with open(path, newline="") as f:
         return list(csv.DictReader(f))
 
 
+def parse_rows(raw_rows, min_qty=0, warn=None):
+    """Convert raw CSV rows into records, applying the min_qty filter.
+
+    Rows with an unparsable qty or price are skipped; one warning line per
+    skipped row is sent to stderr (N is the 1-based data row number).
+    """
+    if warn is None:
+        warn = lambda msg: print(msg, file=sys.stderr)
+    rows = []
+    for n, raw in enumerate(raw_rows, start=1):
+        try:
+            row = {"name": raw["name"], "qty": int(raw["qty"]), "price": float(raw["price"])}
+        except (KeyError, TypeError, ValueError) as exc:
+            warn(f"skipping row {n}: {exc}")
+            continue
+        if row["qty"] >= min_qty:
+            rows.append(row)
+    rows.sort(key=lambda r: r["name"])
+    return rows
+
+
+def render_table(rows):
+    for r in rows:
+        print(f"{r['name']:<20} {r['qty']:>6} {r['price']:>10.2f}")
+
+
+def render_json(rows):
+    print(json.dumps(rows, indent=2))
+
+
 def main(argv=None):
     ap = argparse.ArgumentParser(description="Report stock levels")
     ap.add_argument("csv")
     ap.add_argument("--min-qty", type=int, default=0)
+    ap.add_argument("--format", choices=FORMATS, default="table", help="output format (default: table)")
     a = ap.parse_args(argv)
-    rows = [r for r in load(a.csv) if int(r["qty"]) >= a.min_qty]
-    for r in sorted(rows, key=lambda r: r["name"]):
-        print(f"{r['name']:<20} {int(r['qty']):>6} {float(r['price']):>10.2f}")
+    rows = parse_rows(load(a.csv), min_qty=a.min_qty)
+    if a.format == "json":
+        render_json(rows)
+    else:
+        render_table(rows)
     return 0
 
 
