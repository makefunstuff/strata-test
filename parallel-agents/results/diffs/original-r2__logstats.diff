+class P95Test(unittest.TestCase):
+    @staticmethod
+    def lines(values):
+        return [f"2026-10-01T12:00:00Z GET /a 200 {v}ms" for v in values]
+
+    def test_small_sample(self):
+        self.assertEqual(p95_latency(self.lines([10, 20])), 20)
+        self.assertEqual(p95_latency(self.lines([30, 10, 20])), 30)
+
+    def test_nearest_rank(self):
+        # n=100 -> rank ceil(95) = 95 -> value 95 (1-based) of sorted 1..100
+        self.assertEqual(p95_latency(self.lines(range(1, 101))), 95)
+        # n=10 -> rank ceil(9.5) = 10 -> largest value
+        self.assertEqual(p95_latency(self.lines(range(1, 11))), 10)
+        # n=20 -> rank ceil(19) = 19 -> second largest value
+        self.assertEqual(p95_latency(self.lines(range(1, 21))), 19)
+        # n=1 -> rank 1
+        self.assertEqual(p95_latency(self.lines([7])), 7)
+
+    def test_unsorted_input(self):
+        self.assertEqual(p95_latency(self.lines([500, 10, 20, 30, 40])), 500)
+
+    def test_empty_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            p95_latency([])
+
+    def test_malformed_line_in_sample_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            p95_latency(["garbage"])
+
 
