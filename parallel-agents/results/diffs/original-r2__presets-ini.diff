+"""Spec coverage for presets.py (hand-written parser + report CLI)."""
+
+import io
+import os
+import sys
+import tempfile
+import unittest
+
+import presets
+
+HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+SAMPLE = os.path.join(HERE, "sample.ini")
+
+
+def parse(text):
+    return presets.parse_presets(text)
+
+
+def parse_file(text):
+    with tempfile.TemporaryDirectory() as tmp:
+        path = os.path.join(tmp, "p.ini")
+        with open(path, "w", encoding="utf-8") as fh:
+            fh.write(text)
+        return presets.load_presets(path)
+
+
+class ParseTest(unittest.TestCase):
+    def test_sample_file_order_and_override(self):
+        p = presets.load_presets(SAMPLE)
+        self.assertEqual(list(p), ["qwen3.8-27b", "zeta-2.1-q4"])
+        self.assertEqual(p["zeta-2.1-q4"]["temp"], "0.0")
+        # global defaults inherited
+        self.assertEqual(p["zeta-2.1-q4"]["top-p"], "0.95")
+        self.assertEqual(p["qwen3.8-27b"]["temp"], "1.0")
+
+    def test_strip_and_first_equals_only(self):
+        p = parse("[a]\n  model  =  /x/y=1=v  \n")
+        self.assertEqual(p["a"]["model"], "/x/y=1=v")
+
+    def test_comments_and_blanks(self):
+        p = parse("# c1\n\n   \n  ; c2\n[a]\n\tk = v\n")
+        self.assertEqual(p, {"a": {"k": "v"}})
+
+    def test_keys_before_section_are_defaults(self):
+        p = parse("temp = 1.0\n[a]\nmodel = m\n[b]\ntemp = 0.5\n")
+        self.assertEqual(p["a"], {"temp": "1.0", "model": "m"})
+        self.assertEqual(p["b"], {"temp": "0.5"})
+
+    def test_key_case_preserved_and_last_duplicate_wins(self):
+        p = parse("[A]\nCtx-Size = 1\nctx-size = 2\nCtx-Size = 3\n")
+        self.assertEqual(list(p), ["A"])
+        self.assertEqual(p["A"]["Ctx-Size"], "3")
+        self.assertEqual(p["A"]["ctx-size"], "2")
+
+    def test_values_keep_inline_hashes(self):
+        p = parse("[a]\nk = v # not a comment\n")
+        self.assertEqual(p["a"]["k"], "v # not a comment")
+
+    def test_empty_section_gets_defaults(self):
+        self.assertEqual(parse("k = v\n[empty]\n"), {"empty": {"k": "v"}})
+
+    def test_values_are_strings(self):
+        for value in parse("[a]\nk = 1\n")["a"].values():
+            self.assertIsInstance(value, str)
+
+    def test_duplicate_section_reports_line(self):
+        with self.assertRaises(ValueError) as cm:
+            parse("[a]\n\n[a]\n")
+        self.assertIn("3", str(cm.exception))
+
+    def test_garbage_line_reports_line(self):
+        with self.assertRaises(ValueError) as cm:
+            parse("# c\n\nbogus line\n")
+        self.assertIn("3", str(cm.exception))
+
+    def test_malformed_section_is_error(self):
+        with self.assertRaises(ValueError):
+            parse("[a\n")
+
+
+class MainTest(unittest.TestCase):
+    def run_main(self, argv):
+        out, err = io.StringIO(), io.StringIO()
+        old_out, old_err = sys.stdout, sys.stderr
+        sys.stdout, sys.stderr = out, err
+        try:
+            rc = presets.main(["presets.py"] + argv)
+        finally:
+            sys.stdout, sys.stderr = old_out, old_err
+        return rc, out.getvalue(), err.getvalue()
+
+    def test_sample_report(self):
+        rc, out, _ = self.run_main([SAMPLE])
+        self.assertEqual(rc, 0)
+        self.assertEqual(
+            out.splitlines(),
+            [
+                "qwen3.8-27b ctx=131072 devices=CUDA0,CUDA1 split=tensor draft=yes",
+                "zeta-2.1-q4 ctx=16384 devices=CUDA0 split=layer draft=no",
+            ],
+        )
+
+    def test_missing_file_is_nonzero(self):
+        rc, _, err = self.run_main([os.path.join(HERE, "nope.ini")])
+        self.assertNotEqual(rc, 0)
+        self.assertIn("nope.ini", err)
+
+    def test_no_args_is_usage(self):
+        rc, _, err = self.run_main([])
+        self.assertNotEqual(rc, 0)
+        self.assertIn("usage", err)
+
+
+if __name__ == "__main__":
+    unittest.main()
