diff --git c/tests/test_usage.py i/tests/test_usage.py
new file mode 100644
index 0000000..eed5dff
--- /dev/null
+++ i/tests/test_usage.py
@@ -0,0 +1,66 @@
+import unittest
+import warnings
+
+from svc.client import Client
+from svc.config import load_config
+from svc.server import Server
+
+
+def call(callable_):
+    with warnings.catch_warnings(record=True) as caught:
+        warnings.simplefilter("always")
+        result = callable_()
+    return result, caught
+
+
+def deprecations(caught):
+    return [w for w in caught if issubclass(w.category, DeprecationWarning)]
+
+
+class ClientTest(unittest.TestCase):
+    def test_request_options_uses_timeout_s(self):
+        config, _ = call(lambda: load_config({"host": "h", "port": 9, "timeout_s": 3}))
+        opts, caught = call(lambda: Client(config).request_options())
+        self.assertEqual(opts["url"], "http://h:9/")
+        self.assertEqual(opts["timeout"], 3)
+        self.assertEqual(deprecations(caught), [])
+
+    def test_request_options_with_defaults_is_quiet(self):
+        config, _ = call(lambda: load_config({}))
+        opts, caught = call(lambda: Client(config).request_options())
+        self.assertEqual(opts["timeout"], 30)
+        self.assertEqual(deprecations(caught), [])
+
+
+class ServerTest(unittest.TestCase):
+    def test_keepalive_deadline_uses_timeout_s(self):
+        config, _ = call(lambda: load_config({"timeout_s": 4}))
+        deadline, caught = call(lambda: Server(config).keepalive_deadline(10))
+        self.assertEqual(deadline, 18)
+        self.assertEqual(deprecations(caught), [])
+
+    def test_keepalive_deadline_with_defaults_is_quiet(self):
+        config, _ = call(lambda: load_config({}))
+        deadline, caught = call(lambda: Server(config).keepalive_deadline(0))
+        self.assertEqual(deadline, 60)
+        self.assertEqual(deprecations(caught), [])
+
+
+class LegacyConfigCompatibilityTest(unittest.TestCase):
+    """Old-style configs keep working, and the internals stay quiet."""
+
+    def test_old_key_config_drives_client_and_server_quietly(self):
+        config, load_warnings = call(lambda: load_config({"timeout": 6}))
+        self.assertEqual(len(deprecations(load_warnings)), 1)
+
+        opts, caught = call(lambda: Client(config).request_options())
+        self.assertEqual(opts["timeout"], 6)
+        self.assertEqual(deprecations(caught), [])
+
+        deadline, caught = call(lambda: Server(config).keepalive_deadline(1))
+        self.assertEqual(deadline, 13)
+        self.assertEqual(deprecations(caught), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
